<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161b22"
    android:padding="16dp"
    android:layout_margin="6dp"
    android:gravity="center_horizontal">

    <!-- Icon -->
    <TextView
        android:id="@+id/circularIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📄"
        android:textSize="36sp"
        android:layout_marginBottom="10dp"/>

    <!-- Name -->
    <TextView
        android:id="@+id/circularName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Circular Name"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#e6edf3"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"/>

    <!-- Size -->
    <TextView
        android:id="@+id/circularSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 MB"
        android:textSize="11sp"
        android:textColor="#00d4a0"
        android:background="#1a3a2e"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"/>

</LinearLayout>